# ---- Nexxus brand-service connection ----
#
# Dev talks to the hosted API through a Vite proxy (vite.config.ts) to avoid
# browser CORS: the browser hits same-origin /nexxus/* and Vite forwards it.

# Hosted API the dev proxy forwards to.
VITE_API_TARGET=https://api.nexxus.fynxt.io

# Dev: leave empty (requests are same-origin and proxied).
# Prod: set to the hosted URL when serving from an allowed origin.
VITE_API_BASE_URL=

# API prefix (backend .env -> API_PREFIX)
VITE_NEXXUS_API_PREFIX=/nexxus/v1

# ---- Auth ----
# The flow APIs (/psps/currencies, /requests/fetch-psp, /transactions) authenticate
# with an environment secret token, sent as the `x-secret-token` header. The brand
# and environment are resolved from the token server-side.
VITE_SECRET_TOKEN=