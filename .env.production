# Production build config (committed; contains NO secrets).
# Requests go same-origin to /nexxus/v1 and are handled by the Vercel serverless
# proxy (api/nexxus/[...path].js), which injects the token server-side.

VITE_API_BASE_URL=
VITE_NEXXUS_API_PREFIX=/nexxus/v1

# Auth is handled by the server-side proxy, so the client sends no token and the
# "no token configured" notice is suppressed.
VITE_AUTH_VIA_PROXY=true

# MUST stay empty in production. A value here rewrites the origin of every
# sessionUrl the backend returns, which would send real payers to that host.
VITE_WIDGET_ORIGIN=

